# Build the focused offline Base devnet generator.
build:
    go build -o bin/op-deployer ./cmd/op-deployer

# Check supported CLI and upgrade-schedule behavior.
test:
    go test ./cmd/op-deployer ./cmd/extract-artifacts

# Build the image-build utility; it is not a runtime subcommand.
build-artifact-extractor:
    go build -o bin/extract-artifacts ./cmd/extract-artifacts

# Regenerate embedded artifacts after intentionally rebuilding Solidity contracts.
copy-contract-artifacts:
    go run ./pkg/deployer/artifacts/cmd/mktar -base ../packages/contracts-bedrock -out ./pkg/deployer/artifacts/forge-artifacts/artifacts.tzst --exclude="*.t.sol"
